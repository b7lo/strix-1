# ═══════════════════════════════════════════════════════════════════
# Strix App (Expo) — متغيّرات البيئة العامة (EXPO_PUBLIC_*)
# انسخ هذا الملف إلى .env واملأ القيم. لا تضع أي مفاتيح سرّية هنا —
# كل EXPO_PUBLIC_* تُضمَّن في حزمة العميل وتكون مرئية للمستخدمين.
# ═══════════════════════════════════════════════════════════════════

# مشروع Supabase (المصادقة + قاعدة البيانات)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# خادم Strix API (رفع الحوادث + حذف الحساب عبر /api/account)
EXPO_PUBLIC_STRIX_API_URL=https://api.yourdomain.com
# مفتاح استقبال البلاغات (يحمي مسار /accidents من الحقن العام)
EXPO_PUBLIC_STRIX_INGEST_KEY=your-ingest-key
