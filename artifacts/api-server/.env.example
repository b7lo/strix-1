# ═══════════════════════════════════════════════════════════════════
# Strix API Server — متغيّرات البيئة (الخادم فقط، لا تُكشف للتطبيق)
# انسخ إلى .env واملأ القيم في بيئة النشر (Coolify). لا تُضِف .env للريبو.
# ═══════════════════════════════════════════════════════════════════

# قاعدة البيانات (Postgres/Supabase)
DATABASE_URL=postgres://user:password@host:5432/dbname

# مصادقة لوحة تحكم الأدمن (توكن HS256)
AUTH_SECRET=change-me-to-a-long-random-string-min-16-chars
ADMIN_EMAIL=admin@yourdomain.com
# يُفضّل هاش scrypt (scripts/hash-password.mjs)؛ أو نص صريح للتطوير فقط
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# أصول لوحة التحكم المسموحة (CORS) — مفصولة بفواصل
DASHBOARD_ORIGIN=https://dashboard.yourdomain.com

# مفتاح استقبال البلاغات من التطبيق (يطابق EXPO_PUBLIC_STRIX_INGEST_KEY)
STRIX_INGEST_KEY=your-ingest-key

# ─── حذف الحساب عبر service role (المتطلب 5.5) ───
# مفتاح service role سرّي — الخادم فقط، لا يظهر في التطبيق أو الريبو أبداً.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
